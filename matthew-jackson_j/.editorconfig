root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true

[*.ps1]
end_of_line = crlf

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,xml,props,targets,csproj,sln,slnx}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

# .NET style defaults
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Naming rules
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.methods.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.methods_must_be_pascal.symbols = methods
dotnet_naming_rule.methods_must_be_pascal.style = pascal_case
dotnet_naming_rule.methods_must_be_pascal.severity = warning