#!/usr/bin/env bash
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/_payeredi_common.sh"

require_command docker

compose --profile test-db up -d vadb-test
container_id="$(compose --profile test-db ps -q vadb-test)"

for attempt in {1..60}; do
    health_status="$(docker inspect --format '{{.State.Health.Status}}' "$container_id" 2>/dev/null || true)"
    case "$health_status" in
        healthy)
            compose --profile test-db run --rm --no-deps db-init-test
            export EDI_PROCESSOR_CONNECTIONSTRINGS__MIGRATION="Server=localhost,1434;Database=PayerEdi;User Id=sa;Password=${MSSQL_SA_PASSWORD:-password_123};TrustServerCertificate=True"
            dotnet tool restore
            dotnet ef database update \
                --project src/PayerEDI.Data \
                --startup-project src/PayerEDI.Processor.Console
            printf 'PayerEdi functional-test database is ready.\n'
            exit 0
            ;;
        unhealthy)
            compose --profile test-db logs vadb-test >&2 || true
            printf 'Functional-test SQL Server reported an unhealthy status.\n' >&2
            exit 1
            ;;
    esac
    sleep 2
done

compose --profile test-db logs vadb-test >&2 || true
printf 'Timed out waiting for functional-test SQL Server.\n' >&2
exit 1
